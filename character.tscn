[sub_resource type="GDScript" id="GDScript_bjcjn"]
script/source = "extends CharacterBody3D

@export var mouse_sensitivity := 0.003

# @onready: find this node once the scene is ready
@onready var pivot: Node3D = $CameraPivot


@export var speed := 4.0
# Read gravity from Project Settings (9.8 by default)
var gravity: float = ProjectSettings.get_setting(\"physics/3d/default_gravity\")

func _ready():
	# Hide the mouse and lock it to the game window
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED


func _unhandled_input(event):
	 # Mouse moved: rotate the camera pivot
	if event is InputEventMouseMotion and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:
		pivot.rotation.y -= event.relative.x * mouse_sensitivity   # left/right
		pivot.rotation.x -= event.relative.y * mouse_sensitivity   # up/down
		# Stop the camera from flipping over the top or going under the ground
		pivot.rotation.x = clamp(pivot.rotation.x, deg_to_rad(-40), deg_to_rad(30))

	# Esc frees the mouse; clicking captures it again
	if event.is_action_pressed(\"ui_cancel\"):
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	elif event is InputEventMouseButton and event.pressed:
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

func _physics_process(delta):
		# 1. GRAVITY: if we're in the air, pull down a little more each frame
	if not is_on_floor():
		velocity.y -= gravity * delta #only this line is within the if statement block
		# 2. INPUT: turn the four keys into one direction
	# 2. INPUT: turn the four keys into one direction
	var input_dir := Input.get_vector(\"move_left\", \"move_right\", \"move_forward\", \"move_back\")
	var direction := Vector3(input_dir.x, 0, input_dir.y).rotated(Vector3.UP, pivot.rotation.y).normalized()

# 3. SPEED: move if a key is pressed, stop if not
	if direction:
		velocity.x = direction.x * speed
		velocity.z = direction.z * speed
	else:
		velocity.x = 0
		velocity.z = 0
# 4. MOVE: let Godot handle the collisions
	move_and_slide()
"

